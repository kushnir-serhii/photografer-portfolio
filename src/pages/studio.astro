---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryBlock from '../components/StoryBlock.astro';
import Marquee from '../components/Marquee.astro';
import Testimonial from '../components/Testimonial.astro';
import ClosingCta from '../components/ClosingCta.astro';
import ServiceArea from '../components/ServiceArea.astro';
import { pictures, studioPage as s, testimonial } from '../data/site';
---
<BaseLayout title={s.title} description={s.description}>
  <section class="sh-section">
    <div class="sh-container">
      <StoryBlock image={pictures.studioPortrait.src} alt={pictures.studioPortrait.alt} cursorLabel="Hello">
        <p class="sh-meta" data-reveal>{s.eyebrow}</p>
        <h1 class="sh-d-xl" data-split>{s.heading}</h1>
        <p class="sh-lead sh-measure" data-reveal data-reveal-delay="140">{s.lead}</p>
        <p class="sh-muted sh-measure" data-reveal data-reveal-delay="200">{s.about}</p>
      </StoryBlock>
    </div>
  </section>

  <Marquee items={s.marquee} />

  <section class="sh-section">
    <div class="sh-container">
      <div class="sh-plans">
        {s.principles.map((p) => (
          <div class="sh-plan">
            <p class="sh-meta">{p.no}</p>
            <h2 class="sh-d-s sh-plan__title">{p.title}</h2>
            <p class="sh-muted sh-body-s sh-plan__body">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sh-section sh-section--band">
    <div class="sh-container">
      <StoryBlock image={pictures.studioOnSet.src} alt={pictures.studioOnSet.alt} reverse>
        <h2 class="sh-d-l" data-split>{s.run.title}</h2>
        <ol class="sh-steps" data-reveal data-reveal-delay="140">
          {s.run.steps.map((step, i) => (
            <li class="sh-steps__item">
              <span class="sh-steps__no">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="sh-d-s sh-plan__title">{step.title}</h3>
                <p class="sh-muted sh-body-s sh-steps__text">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
        <p data-reveal data-reveal-delay="200"><a class="sh-btn sh-btn--outline" href="/rates/">{s.run.cta}</a></p>
      </StoryBlock>
    </div>
  </section>

  <section class="sh-section">
    <div class="sh-container sh-studio-split">
      <div>
        <h2 class="sh-d-l" data-split>{s.clients.title}</h2>
        <p class="sh-muted sh-measure sh-studio-cta" data-reveal>{s.clients.text}</p>
      </div>
      <div>
        <h2 class="sh-d-l" data-split>{s.gets.title}</h2>
        <ul class="sh-gets sh-studio-cta" data-reveal>
          {s.gets.items.map((g) => (
            <li class="sh-gets__item">
              <p class="sh-meta">{g.label}</p>
              <p class="sh-muted">{g.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <ServiceArea />

  <section class="sh-section sh-section--band">
    <div class="sh-container">
      <Testimonial quote={testimonial.quote} by={testimonial.by} role={testimonial.role} />
    </div>
  </section>

  <ClosingCta />
</BaseLayout>
