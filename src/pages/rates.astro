---
import BaseLayout from '../layouts/BaseLayout.astro';
import Packages from '../components/Packages.astro';
import StoryBlock from '../components/StoryBlock.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { plans, pictures, ratesPage, addOns, faq } from '../data/site';
---
<BaseLayout title={ratesPage.title} description={ratesPage.description}>
  <section class="sh-section">
    <div class="sh-container">
      <p class="sh-meta sh-head__eyebrow" data-reveal>{ratesPage.eyebrow}</p>
      <h1 class="sh-d-xl sh-head__title" data-split>{ratesPage.heading}</h1>
      <p class="sh-lead sh-measure sh-head__lead" data-reveal data-reveal-delay="140">{ratesPage.lead}</p>
    </div>
  </section>

  <section class="sh-section sh-section--flush">
    <Packages plans={plans} />
    <div class="sh-container sh-rates__note">
      <p class="sh-meta">{ratesPage.note}</p>
    </div>
  </section>

  <section class="sh-section sh-section--band">
    <div class="sh-container">
      <StoryBlock image={pictures.rates.src} alt={pictures.rates.alt} ratio="3x2" reverse>
        <p class="sh-meta" data-reveal>{ratesPage.addOnsEyebrow}</p>
        <h2 class="sh-d-l sh-addons__title" data-split>{ratesPage.addOnsTitle}</h2>
        <ul class="sh-addons">
          {addOns.map((a) => (
            <li class="sh-addons__item">
              <span class="sh-addons__name">
                {a.name}
                {a.detail && <span class="sh-addons__detail">{a.detail}</span>}
              </span>
              <span class="sh-addons__price">{a.price}</span>
            </li>
          ))}
        </ul>
        <p class="sh-meta-s">{ratesPage.addOnsNote}</p>
      </StoryBlock>
    </div>
  </section>

  <section class="sh-section">
    <div class="sh-container sh-container--narrow">
      <p class="sh-meta sh-faq__eyebrow" data-reveal>{ratesPage.faqEyebrow}</p>
      <h2 class="sh-d-l sh-faq__title" data-split>{ratesPage.faqTitle}</h2>
      <div class="sh-faq" data-reveal>
        {faq.map((item) => (
          <details class="sh-faq__item">
            <summary class="sh-faq__q">
              <h3 class="sh-d-s">{item.q}</h3>
              <span class="sh-faq__icon" aria-hidden="true"></span>
            </summary>
            <p class="sh-muted sh-faq__a">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <ClosingCta />
</BaseLayout>
