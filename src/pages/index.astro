---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Slider from '../components/Slider.astro';
import IndexList from '../components/IndexList.astro';
import StoryBlock from '../components/StoryBlock.astro';
import Packages from '../components/Packages.astro';
import Testimonial from '../components/Testimonial.astro';
import ClosingCta from '../components/ClosingCta.astro';
import {
  projects, plans, hero, marquee, testimonial, categories, pictures,
  intro, howItWorks, packagesIntro, sectorRows,
} from '../data/site';
---
<BaseLayout>
  <Hero
    image={hero.image}
    alt={hero.alt}
    eyebrow={hero.eyebrow}
    title={hero.title}
    lead={hero.lead}
    disciplines={categories.filter((c) => c.id !== 'all').map((c) => c.label).join(' · ')}
  >
    <a class="sh-btn sh-btn--primary" href="/contact/" data-magnetic="0.25">Book a shoot</a>
    <a class="sh-btn sh-btn--on-image" href="/work/">Selected work</a>
  </Hero>

  <div id="after-hero">
    <Marquee accent speed={20} items={marquee} />
  </div>

  <section class="sh-section">
    <div class="sh-container">
      <div class="sh-intro">
        <h2 class="sh-d-l" data-split>{intro.title}</h2>
        <p class="sh-lead sh-measure" data-reveal data-reveal-delay="140">{intro.lead}</p>
      </div>
    </div>
  </section>

  <section class="sh-section sh-section--flush">
    <div class="sh-container--wide">
      <div class="sh-section-head">
        <h2 class="sh-d-l" data-split>Selected projects</h2>
        <p class="sh-meta" data-reveal>Drag · or use the arrows</p>
      </div>
      <Slider projects={projects} label="Selected projects" autoplay={5600} />
    </div>
  </section>

  <section class="sh-section">
    <div class="sh-container">
      <div class="sh-section-head">
        <h2 class="sh-d-l" data-split>What I shoot</h2>
        <a class="sh-link" href="/work/">All work</a>
      </div>
      <IndexList rows={sectorRows} />
    </div>
  </section>

  <section class="sh-section sh-section--band">
    <div class="sh-container">
      <StoryBlock image={pictures.howItWorks.src} alt={pictures.howItWorks.alt}>
        <p class="sh-meta" data-reveal>{howItWorks.eyebrow}</p>
        <h2 class="sh-d-l" data-split>{howItWorks.title}</h2>
        <ol class="sh-steps">
          {howItWorks.steps.map((step, i) => (
            <li class="sh-steps__item" data-reveal data-reveal-delay={String(120 + i * 60)}>
              <span class="sh-steps__no">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="sh-d-s">{step.title}</h3>
                <p class="sh-muted sh-body-s sh-steps__text">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
        <p data-reveal data-reveal-delay="380"><a class="sh-link" href="/studio/">Read the full approach</a></p>
      </StoryBlock>
    </div>
  </section>

  <section class="sh-section">
    <div class="sh-container">
      <div class="sh-block-head">
        <p class="sh-meta" data-reveal>{packagesIntro.eyebrow}</p>
        <h2 class="sh-d-l" data-split>{packagesIntro.title}</h2>
        <p class="sh-muted" data-reveal data-reveal-delay="140">{packagesIntro.lead}</p>
      </div>
    </div>
    <Packages plans={plans} />
  </section>

  <section class="sh-section sh-section--band">
    <div class="sh-container">
      <Testimonial quote={testimonial.quote} by={testimonial.by} role={testimonial.role} />
    </div>
  </section>

  <ClosingCta />
</BaseLayout>
