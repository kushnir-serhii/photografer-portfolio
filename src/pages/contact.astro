---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';

const steps = [
  { no: '01', title: 'A reply', body: 'Within two days, with availability and the full price list.' },
  { no: '02', title: 'A call', body: 'Half an hour, camera off if you prefer, no pitch.' },
  { no: '03', title: 'The date', body: 'Agreement, 25 percent, and the day is yours.' },
];
---
<BaseLayout title="Contact" description="Tell us the date. Every enquiry gets a written reply within two days.">
  <section class="sh-section">
    <div class="sh-container">
      <div class="sh-story" style="align-items:start;">
        <div class="sh-story__body">
          <p class="sh-meta" data-reveal>Enquire</p>
          <h1 class="sh-d-xl" data-split style="margin:0;">Tell us the date</h1>
          <p class="sh-lead sh-measure" data-reveal data-reveal-delay="140" style="margin:0;">
            Every enquiry gets a written reply within two days — date free or not.
          </p>
          <ContactForm />
        </div>
        <div class="sh-story__media" style="display:grid;gap:28px;">
          <div class="sh-frame" data-reveal="clip" data-cursor-label="View">
            <img class="sh-img sh-ratio-4x5" alt="Late in the evening" src="/images/late-in-the-evening.jpg" loading="lazy" />
          </div>
          <div>
            <p class="sh-meta" style="margin-bottom:14px;">Directly</p>
            <ul class="sh-footer__list">
              <li><a class="sh-link" href={`mailto:${site.email}`}>{site.email}</a></li>
              <li><a class="sh-link" href={site.phoneHref}>{site.phone}</a></li>
              <li><span class="sh-muted sh-body-s">Poznań · replies Mon–Fri</span></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sh-section sh-section--band">
    <div class="sh-container">
      <h2 class="sh-meta" data-reveal style="margin-bottom:28px;">What happens next</h2>
      <div class="sh-plans">
        {steps.map((s) => (
          <div class="sh-plan">
            <p class="sh-meta">{s.no}</p>
            <h3 class="sh-d-s" style="margin:0;">{s.title}</h3>
            <p class="sh-muted sh-body-s" style="margin:0;">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
