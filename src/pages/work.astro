---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import ClosingCta from '../components/ClosingCta.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { frames, projects, workPage } from '../data/site';
---
<BaseLayout title="Work" description="Brand, food, product, team and film work for small brands and marketing teams in London.">
  <section class="sh-section">
    <div class="sh-container">
      <p class="sh-meta sh-head__eyebrow" data-reveal>{workPage.eyebrow}</p>
      <h1 class="sh-d-xl sh-head__title" data-split>{workPage.title}</h1>
      <p class="sh-lead sh-measure sh-head__lead" data-reveal data-reveal-delay="140">{workPage.lead}</p>
    </div>
  </section>

  <section class="sh-section sh-section--flush">
    <GalleryGrid frames={frames} />
  </section>

  <section class="sh-section sh-section--band">
    <div class="sh-container">
      <div class="sh-block-head">
        <h2 class="sh-d-l" data-split>{workPage.projectsTitle}</h2>
        <p class="sh-muted" data-reveal>{workPage.projectsLead}</p>
      </div>
      <div class="sh-projects">
        {projects.map((p) => <ProjectCard project={p} anchor />)}
      </div>
    </div>
  </section>

  <ClosingCta />
</BaseLayout>
