---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Not found">
  <section class="sh-section sh-section--huge">
    <div class="sh-container" style="text-align:center;">
      <p class="sh-meta" style="margin-bottom:18px;">404</p>
      <h1 class="sh-d-xl" style="margin:0 auto 28px;max-width:14ch;">This page is not here</h1>
      <a class="sh-btn sh-btn--primary sh-btn--lg" href="/">Back to the start</a>
    </div>
  </section>
</BaseLayout>
