---
import '../styles/tokens.css';
import '../styles/components.css';
import '../styles/site.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuickContact from '../components/QuickContact.astro';
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import JsonLd from '../components/JsonLd.astro';
import { site, hero } from '../data/site';
import { businessSchema, type JsonLdObject } from '../data/schema';

interface Props {
  title?: string;
  description?: string;
  // A built image URL (e.g. from getImage); defaults to the hero photo.
  image?: string;
  // Page-specific JSON-LD objects (see src/data/schema.ts); the business block is always added.
  schema?: JsonLdObject[];
  // Keeps the page out of search results (client galleries).
  noindex?: boolean;
}
// Default share image: the hero photo at 1200px as a JPG, the format social previews expect.
const ogDefault = await getImage({ src: hero.image, width: 1200, format: 'jpg' });
const { title, description = site.description, image = ogDefault.src, schema = [], noindex = false } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — brand & commercial photographer, ${site.city}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" data-theme="night">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!site.indexable ? (
      // Closed site (the demo): no search results, snippets, caches, image search or AI training.
      <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex, noai, noimageai" />
    ) : noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {site.indexable && <link rel="sitemap" href="/sitemap-index.xml" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0a0a0b" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <JsonLd data={businessSchema(Astro.site!, ogDefault.src)} />
    {schema.map((data) => <JsonLd data={data} />)}

    <script is:inline>
      // Restore the theme before first paint so the page never flashes. Client-side
      // navigation copies <html> attributes from the incoming page, so re-apply it
      // onto each new document before it is swapped in.
      (function () {
        if (window.__shThemeRestore) return;
        function restore(doc) {
          var saved = null;
          try { saved = localStorage.getItem('sh-theme'); } catch (e) {}
          if (!saved && window.matchMedia && matchMedia('(prefers-color-scheme: light)').matches) saved = 'day';
          if (saved) doc.documentElement.setAttribute('data-theme', saved);
          if (doc !== document) doc.documentElement.classList.add('sh-js');
        }
        window.__shThemeRestore = restore;
        restore(document);
        document.addEventListener('astro:before-swap', function (e) { restore(e.newDocument); });
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Instrument+Sans:wght@400;500&family=JetBrains+Mono:wght@500&display=swap"
    />

    <ClientRouter />
  </head>
  <body>
    <div class="sh-page">
      <a class="sh-skip" href="#main-content">Skip to content</a>
      <Header />
      <main id="main-content">
        <slot />
      </main>
      <Footer />
      <QuickContact />
    </div>
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
