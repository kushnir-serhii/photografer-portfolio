---
interface Props {
  name: 'burger' | 'close' | 'arrow-left' | 'arrow-right' | 'scroll' | 'error' | 'check';
}
const { name } = Astro.props;
---
{name === 'burger' && (
  <svg width="16" height="10" viewBox="0 0 16 10" aria-hidden="true"><path d="M0 1h16M0 9h16" stroke="currentColor" stroke-width="1.4" /></svg>
)}
{name === 'close' && (
  <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 1l12 12M13 1 1 13" stroke="currentColor" stroke-width="1.4" /></svg>
)}
{name === 'arrow-left' && (
  <svg width="15" height="12" viewBox="0 0 15 12" aria-hidden="true"><path d="M15 6H2M6.6 1.2 1.6 6l5 4.8" fill="none" stroke="currentColor" stroke-width="1.3" /></svg>
)}
{name === 'arrow-right' && (
  <svg width="15" height="12" viewBox="0 0 15 12" aria-hidden="true"><path d="M0 6h13M8.4 1.2 13.4 6l-5 4.8" fill="none" stroke="currentColor" stroke-width="1.3" /></svg>
)}
{name === 'scroll' && (
  <svg width="7" height="9" viewBox="0 0 7 9" aria-hidden="true"><path d="M3.5 0v7.4M1 5.4l2.5 2.6L6 5.4" fill="none" stroke="currentColor" stroke-width="1" /></svg>
)}
{name === 'error' && (
  <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.3" /><path d="M8 4.2v4.6M8 10.6v1.2" stroke="currentColor" stroke-width="1.4" /></svg>
)}
{name === 'check' && (
  <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.3" /><path d="M4.8 8.2l2.2 2.2 4.2-4.6" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
)}
