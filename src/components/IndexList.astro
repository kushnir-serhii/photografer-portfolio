---
import type { Day } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  days: Day[];
}
const { days } = Astro.props;
---
<div class="sh-index" data-index-list>
  <div class="sh-index__preview" data-index-preview aria-hidden="true">
    <img class="sh-img" alt="" src={days[0]?.image} />
  </div>
  {days.map((day, i) => (
    <a class="sh-index__row" href="/work/" data-index-item data-index-img={day.image}>
      <span class="sh-index__no">{String(i + 1).padStart(2, '0')}</span>
      <span class="sh-d-m">{day.title}</span>
      <span class="sh-index__meta">{day.venue} · {day.year}</span>
      <span class="sh-index__arrow" aria-hidden="true"><Icon name="arrow-right" /></span>
    </a>
  ))}
</div>
