---
import type { Plan } from '../data/site';

interface Props {
  plans: Plan[];
}
const { plans } = Astro.props;
---
<div class="sh-plans">
  {plans.map((plan) => (
    <article class:list={['sh-plan', { 'sh-plan--feature': plan.featured }]}>
      <div class="sh-plan__head">
        <p class="sh-meta">{plan.no} — {plan.name}</p>
        {plan.featured && <p class="sh-plan__tag">Most booked</p>}
      </div>
      <div class="sh-plan__cost">
        <p class="sh-plan__price">{plan.price}</p>
        <p class="sh-plan__unit">{plan.unit} · ex VAT</p>
      </div>
      <ul class="sh-plan__list">
        {plan.items.map((item) => <li><span>{item}</span></li>)}
      </ul>
      <p class="sh-plan__usage"><span class="sh-meta-s">Usage included</span><span>{plan.usage}</span></p>
      {plan.featured
        ? <a class="sh-btn sh-btn--primary" href="/contact/" data-magnetic="0.2">Book a shoot</a>
        : <a class="sh-btn sh-btn--outline" href="/contact/">Ask about this</a>}
    </article>
  ))}
</div>
