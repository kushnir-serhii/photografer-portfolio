---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  alt: string;
  ratio?: '4x5' | '3x2';
  reverse?: boolean;
  cursorLabel?: string;
}
const { image, alt, ratio = '4x5', reverse = false, cursorLabel = 'View' } = Astro.props;
---
<div class:list={['sh-story', { 'sh-story--reverse': reverse }]}>
  <div class="sh-story__media sh-frame" data-reveal="clip" data-cursor-label={cursorLabel}>
    <Picture
      class={`sh-img sh-ratio-${ratio}`}
      pictureAttributes={{ class: 'sh-pic' }}
      src={image}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[480, 720, 960, 1280, 1600]}
      sizes="(min-width: 1440px) 640px, (min-width: 900px) 45vw, 100vw"
      loading="lazy"
    />
  </div>
  <div class="sh-story__body">
    <slot />
  </div>
</div>
