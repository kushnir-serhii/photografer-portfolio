---
import { site, plans, addOns, quoteCopy, shootTypes, budgetRanges, enquiryForm as copy } from '../data/site';
import type { Plan } from '../data/site';
import { areas } from '../data/areas';
import { formatPrice } from '../data/format';
import { clientGalleries, gallerySelects } from '../data/client-galleries';
import { formatDate } from '../scripts/dates';
import Icon from './Icon.astro';

// Option text doubles as the submitted value, so the email reads "Full day — £1,750".
const planText = (p: Plan) => `${p.name} — ${formatPrice(p.price)}${p.unit === 'per shoot' ? '' : ` ${p.unit}`}`;
// Slug -> name for ?area=; the script fills the brief from it.
const areaData = JSON.stringify(Object.fromEntries(areas.map((a) => [a.slug, a.name])));
// What the script needs to rebuild a quote from ?plan=&qty=&addons= and pick the budget; options are in budgetRanges order.
const quoteData = JSON.stringify({
  plans: plans.map(({ id, name, price, qty }) => ({ id, name, price, qty })),
  addOns: addOns.map(({ id, name, price, priceFrom, qty }) => ({ id, name, price, priceFrom, qty })),
  copy: quoteCopy,
  budgets: budgetRanges,
});
// ?gallery=&selects= from a client gallery (demo only): slug, shoot, date and frame ids, to check the link and write the brief.
const selectsGalleries = site.demo
  ? JSON.stringify(clientGalleries.map((g) => ({
      slug: g.slug,
      shoot: `${g.client} — ${g.title}`,
      date: formatDate(g.date) ?? g.date,
      ids: g.frames.map((f) => f.id),
    })))
  : undefined;
const selectsCopy = site.demo ? JSON.stringify(gallerySelects) : undefined;
const action = site.formEndpoint || `mailto:${site.email}`;
---
<form
  class="sh-form sh-enquiry"
  method="post"
  action={action}
  enctype={site.formEndpoint ? undefined : 'text/plain'}
  novalidate
  data-enquiry
  data-endpoint={site.formEndpoint}
  data-areas={areaData}
  data-area-brief={copy.briefArea}
  data-quote-data={quoteData}
  data-galleries={selectsGalleries}
  data-selects-copy={selectsCopy}
>
  <p class="sh-enquiry__choice sh-body-s" data-plan-choice aria-live="polite" hidden>
    <span data-plan-choice-text></span> · <button class="sh-enquiry__change" type="button" data-plan-change>{copy.packageChange}</button><span data-quote-edit-wrap hidden> · <a class="sh-link" href="/rates/#quote" data-quote-edit>{copy.quoteEdit}</a></span>
  </p>
  <input type="hidden" name="quote" value="" disabled data-quote-field />
  <div class="sh-row sh-row--2">
    <div class="sh-field">
      <label class="sh-label" for="c-name">Your name</label>
      <input class="sh-input" id="c-name" name="name" type="text" placeholder={copy.namePlaceholder} autocomplete="name" required aria-describedby="c-name-err" />
      <p class="sh-error" id="c-name-err" hidden><Icon name="error" /><span>Tell me who I am writing back to.</span></p>
    </div>
    <div class="sh-field">
      <label class="sh-label" for="c-company">Company <span class="sh-label__opt">(optional)</span></label>
      <input class="sh-input" id="c-company" name="company" type="text" placeholder={copy.companyPlaceholder} autocomplete="organization" />
    </div>
  </div>
  <div class="sh-field">
    <label class="sh-label" for="c-mail">Email</label>
    <input class="sh-input" id="c-mail" name="email" type="email" placeholder={copy.emailPlaceholder} autocomplete="email" required aria-describedby="c-mail-err" />
    <p class="sh-error" id="c-mail-err" hidden><Icon name="error" /><span>This email address does not look complete.</span></p>
  </div>
  <div class="sh-row sh-row--2">
    <div class="sh-field">
      <label class="sh-label" for="c-package">{copy.packageLabel}</label>
      <select class="sh-select" id="c-package" name="package" data-plan-select>
        {plans.map((p) => <option data-plan={p.id} data-choice={`${planText(p)}${p.unit === 'per shoot' ? ' ex VAT' : ', ex VAT'}`}>{planText(p)}</option>)}
        <option data-plan="" selected>{copy.packageNone}</option>
      </select>
    </div>
    <div class="sh-field">
      <label class="sh-label" for="c-date">Preferred date <span class="sh-label__opt">(optional)</span></label>
      <input class="sh-input" id="c-date" name="preferred_date" type="text" placeholder={copy.datePlaceholder} autocomplete="off" aria-describedby="c-date-help" />
      <p class="sh-help" id="c-date-help">{copy.dateHelp}</p>
    </div>
  </div>
  <div class="sh-row sh-row--2">
    <div class="sh-field">
      <label class="sh-label" for="c-kind">Shoot type</label>
      <select class="sh-select" id="c-kind" name="shoot_type">
        {shootTypes.map((t) => <option>{t}</option>)}
      </select>
    </div>
    <div class="sh-field">
      <label class="sh-label" for="c-budget">Budget, ex VAT</label>
      <select class="sh-select" id="c-budget" name="budget">
        {budgetRanges.map((b) => <option>{b.label}</option>)}
      </select>
    </div>
  </div>
  <div class="sh-field">
    <label class="sh-label" for="c-msg">The brief</label>
    <textarea class="sh-textarea" id="c-msg" name="brief" placeholder={copy.briefPlaceholder} aria-describedby="c-msg-help"></textarea>
    <p class="sh-help" id="c-msg-help">{copy.briefHelp}</p>
  </div>
  <div class="sh-sr-only" aria-hidden="true">
    <label for="c-website">Leave this empty</label>
    <input id="c-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <div class="sh-field">
    <label class="sh-check"><input type="checkbox" name="consent" value="yes" required aria-describedby="c-consent-err" /><span>{copy.consent}</span></label>
    <p class="sh-error" id="c-consent-err" hidden><Icon name="error" /><span>I need your permission to reply.</span></p>
  </div>
  <div>
    <button class="sh-btn sh-btn--primary" type="submit" data-magnetic="0.2">{copy.submit}</button>
  </div>
  <p class="sh-success" role="status" data-form-success hidden><Icon name="check" /><span>{copy.success}</span></p>
  <p class="sh-error" role="alert" data-form-failure hidden><Icon name="error" /><span>{copy.failure} <a class="sh-link" href={`mailto:${site.email}`}>{site.email}</a>.</span></p>
</form>
