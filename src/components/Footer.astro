---
import { nav, site, clientGalleriesHref } from '../data/site';
import { areas, areaLabel, serviceArea } from '../data/areas';
---
<footer class="sh-footer">
  <div class="sh-container">
    <div class="sh-footer__cols sh-footer__cols--4">
      <div>
        <p class="sh-d-s" style="margin:0 0 12px;">Booking from {site.season}.</p>
        <p class="sh-muted sh-body-s" style="max-width:32ch;margin:0 0 20px;">Brand, food, product and team photography in London, and wherever the work is.</p>
        <a class="sh-btn sh-btn--outline" href="/contact/">Book a shoot</a>
      </div>
      <div>
        <p class="sh-meta" style="margin-bottom:16px;">Pages</p>
        <ul class="sh-footer__list">
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="sh-meta" style="margin-bottom:16px;">Elsewhere</p>
        <ul class="sh-footer__list">
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={site.phoneHref}>{site.phone}</a></li>
          <li><a href={site.instagram} rel="noopener">Instagram</a></li>
          {clientGalleriesHref && <li><a href={clientGalleriesHref}>Client galleries</a></li>}
        </ul>
      </div>
      <div>
        <p class="sh-meta" style="margin-bottom:16px;">{serviceArea.footerTitle}</p>
        <ul class="sh-footer__list sh-footer__list--areas">
          {areas.map((a) => <li><a href={`/brand-photographer/${a.slug}/`}>{areaLabel(a)}</a></li>)}
        </ul>
      </div>
    </div>
    <div class="sh-footer__bottom">
      <span class="sh-meta-s">© {new Date().getFullYear()} {site.name}</span>
      <span class="sh-meta-s"><a class="sh-link" href="/privacy/">Privacy</a></span>
    </div>
    <p class="sh-footer__word" aria-hidden="true">{site.name}</p>
  </div>
</footer>
