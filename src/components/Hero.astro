---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  eyebrow: string;
  title: string;
  // One line under the headline: who, what and where.
  lead?: string;
  disciplines: string;
}
const { image, alt, eyebrow, title, lead, disciplines } = Astro.props;
---
<section class="sh-hero">
  <div class="sh-hero__media">
    <Picture
      class="sh-img"
      pictureAttributes={{ class: 'sh-pic' }}
      src={image}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1440, 1920, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="sh-container">
    <div class="sh-hero__body">
      <p class="sh-meta">{eyebrow}</p>
      <h1 class="sh-d-hero sh-hero__title" data-split>{title}</h1>
      {lead && <p class="sh-lead sh-hero__lead">{lead}</p>}
      <div class="sh-hero__actions">
        <slot />
      </div>
      <div class="sh-hero__foot">
        <p class="sh-meta sh-hero__disciplines">{disciplines}</p>
        <a class="sh-scroll sh-meta sh-hero__scroll" href="#after-hero">
          <span class="sh-scroll__dot"><Icon name="scroll" /></span>
          Scroll
        </a>
      </div>
    </div>
  </div>
</section>
