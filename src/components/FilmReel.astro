---
// A film behind a poster: client, title, length and a play button over the photograph. Nothing of the
// film loads until it is played. Without JS the poster is a link to the file (or the provider's page);
// src/scripts/film.ts swaps in the player in place and moves focus to it.
import { Picture } from 'astro:assets';
import type { Film } from '../data/site';
import { filmWatchUrl, type FilmPlayerData } from '../data/film';

interface Props {
  film: Film;
  // Start of the button's accessible name: "Play film".
  play: string;
}
const { film, play } = Astro.props;
const name = `${film.client} — ${film.title}`;
const player: FilmPlayerData = { source: film.source, label: name };
---
<div class="sh-film" data-film-reel data-film={JSON.stringify(player)}>
  <div class="sh-film__stage" data-film-stage>
    <a
      class="sh-film__poster"
      href={filmWatchUrl(film.source)}
      data-film-play
      data-cursor-label="Play"
      aria-label={`${play}: ${name} (${film.duration})`}
    >
      <Picture
        class="sh-img"
        pictureAttributes={{ class: 'sh-pic' }}
        src={film.poster}
        alt={film.alt}
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1600, 2000]}
        sizes="(min-width: 1440px) 1344px, (min-width: 721px) calc(100vw - 96px), calc(100vw - 48px)"
        loading="lazy"
      />
      <span class="sh-film__bar">
        <span class="sh-film__cap">
          <span class="sh-meta">{film.client} · {film.duration}</span>
          <span class="sh-d-s sh-film__title">{film.title}</span>
        </span>
        <span class="sh-film__btn">
          <svg width="18" height="20" viewBox="0 0 18 20" aria-hidden="true"><path d="M2 1.5v17L17 10z" fill="currentColor" /></svg>
        </span>
      </span>
    </a>
  </div>
</div>
