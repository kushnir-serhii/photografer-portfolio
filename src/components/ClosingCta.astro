---
import { closingCta } from '../data/site';
---
<section class="sh-section sh-section--huge">
  <div class="sh-container sh-closing">
    <p class="sh-meta" data-reveal>{closingCta.eyebrow}</p>
    <h2 class="sh-d-xl sh-closing__title" data-split>{closingCta.title}</h2>
    <a class="sh-btn sh-btn--primary sh-btn--lg" href="/contact/" data-magnetic="0.25">{closingCta.cta}</a>
    <p class="sh-meta-s sh-closing__meta" data-reveal data-reveal-delay="160">{closingCta.meta}</p>
  </div>
</section>
