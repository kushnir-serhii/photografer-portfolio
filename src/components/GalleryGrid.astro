---
import { Picture } from 'astro:assets';
import { categories, type Frame, type GallerySize } from '../data/site';

interface Props {
  frames: Frame[];
}
const { frames } = Astro.props;
const delays = [0, 90, 150];
// Rendered width of each size: 12 grid columns above 860px, 6 below.
const sizes: Record<GallerySize, string> = {
  default: '(min-width: 861px) 33vw, 50vw',
  tall: '(min-width: 861px) 33vw, 50vw',
  wide: '(min-width: 861px) 66vw, 100vw',
  half: '50vw',
};
---
<div data-gallery>
  <div class="sh-container" style="margin-bottom:24px;">
    <div class="sh-filters" role="group" aria-label="Filter the work">
      {categories.map((c, i) => (
        <button class="sh-chip" type="button" data-filter={c.id} aria-pressed={i === 0 ? 'true' : 'false'}>{c.label}</button>
      ))}
    </div>
  </div>
  <div class="sh-container--wide">
    <div class="sh-gallery">
      {frames.map((frame, i) => (
        <figure
          class:list={['sh-gallery__item', 'sh-frame', frame.size !== 'default' && `sh-gallery__item--${frame.size}`]}
          style="margin:0;"
          data-category={frame.category}
          data-reveal="clip"
          data-reveal-delay={delays[i % 3] || undefined}
          data-cursor-label="View"
        >
          <Picture
            class="sh-img"
            pictureAttributes={{ class: 'sh-pic' }}
            src={frame.src}
            alt={frame.alt}
            formats={['avif', 'webp']}
            widths={[400, 640, 960, 1280, 1600]}
            sizes={sizes[frame.size]}
            loading="lazy"
          />
        </figure>
      ))}
    </div>
    <p class="sh-meta" data-gallery-empty hidden style="margin-top:28px;">Nothing in this set yet.</p>
    <div style="display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;margin-top:28px;">
      <p class="sh-meta">98 frames · 12 days · full galleries sent privately</p>
      <a class="sh-btn sh-btn--outline" href="/contact/">Ask for a full gallery</a>
    </div>
  </div>
</div>
